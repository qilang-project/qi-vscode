{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Qi",
  "scopeName": "source.qi",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.qi",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.qi"
            }
          }
        },
        {
          "name": "comment.block.qi",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.qi"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.qi",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.qi"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.qi"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.qi",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.qi",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.qi"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.qi"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.qi",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.qi",
          "match": "(?<![\\u4e00-\\u9fff\\w])(如果|否则如果|否则|当|对于|循环|跳出|继续|返回|等待|尝试|捕获|抛出|最终|重试|情况|匹配)(?![\\u4e00-\\u9fff\\w])"
        },
        {
          "name": "keyword.declaration.qi",
          "match": "(?<![\\u4e00-\\u9fff\\w])(包|导入|导出|公开|私有|模块|作为|在)(?![\\u4e00-\\u9fff\\w])"
        },
        {
          "name": "keyword.other.qi",
          "match": "(?<![\\u4e00-\\u9fff\\w])(打印行|打印|真|假|空|取地址|解引用|自己)(?![\\u4e00-\\u9fff\\w])"
        },
        {
          "name": "keyword.concurrency.qi",
          "match": "(?<![\\u4e00-\\u9fff\\w])(并发|协程|通道|选择|启动|超时|未来|互斥锁|读写锁|条件变量|等待组|仅一次)(?![\\u4e00-\\u9fff\\w])"
        },
        {
          "name": "storage.type.qi",
          "match": "(?<![\\u4e00-\\u9fff\\w])(异步函数|异步|函数|变量|常量|枚举|结构体|联合体|方法|接口|类型|闭包|内联|新建|参数)(?![\\u4e00-\\u9fff\\w])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.qi",
          "match": "(?<![\\u4e00-\\u9fff\\w])(整数|长整数|短整数|字节|浮点数|布尔|字符|字符串|空)(?![\\u4e00-\\u9fff\\w])"
        },
        {
          "name": "storage.type.collection.qi",
          "match": "(?<![\\u4e00-\\u9fff\\w])(数组|字典|列表|集合|指针|引用|可变引用|通道)(?![\\u4e00-\\u9fff\\w])"
        },
        {
          "name": "storage.type.async.qi",
          "match": "(?<![\\u4e00-\\u9fff\\w])(未来|协程)(?![\\u4e00-\\u9fff\\w])"
        },
        {
          "name": "support.type.qi",
          "match": "([\\u4e00-\\u9fff][\\w\\u4e00-\\u9fff]*)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.qi",
          "match": "([\\u4e00-\\u9fff][\\w\\u4e00-\\u9fff]*)\\s*(?=\\()"
        },
        {
          "name": "entity.name.function.async.qi",
          "match": "异步函数\\s+([\\u4e00-\\u9fff][\\w\\u4e00-\\u9fff]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.qi"
            }
          }
        },
        {
          "name": "entity.name.function.declaration.qi",
          "match": "函数\\s+([\\u4e00-\\u9fff][\\w\\u4e00-\\u9fff]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.qi"
            }
          }
        },
        {
          "name": "meta.function-call.qi",
          "match": "([\\u4e00-\\u9fff][\\w\\u4e00-\\u9fff]*)\\s*(\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.qi"
            },
            "2": {
              "name": "punctuation.definition.parameters.begin.qi"
            }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.qi",
          "match": "([\\u4e00-\\u9fff][\\w\\u4e00-\\u9fff]*)"
        },
        {
          "name": "variable.declaration.qi",
          "match": "变量\\s+([\\u4e00-\\u9fff][\\w\\u4e00-\\u9fff]*)",
          "captures": {
            "1": {
              "name": "variable.other.qi"
            }
          }
        },
        {
          "name": "variable.parameter.qi",
          "match": "([\\u4e00-\\u9fff][\\w\\u4e00-\\u9fff]*)\\s*(?=:)",
          "captures": {
            "1": {
              "name": "variable.parameter.qi"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.qi",
          "match": "(\\+|\\-|\\*|\\/|%)"
        },
        {
          "name": "keyword.operator.comparison.qi",
          "match": "(==|!=|<|<=|>|>=)"
        },
        {
          "name": "keyword.operator.logical.qi",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.qi",
          "match": "(=|\\+=|\\-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.other.qi",
          "match": "(\\.|\\->|::)"
        },
        {
          "name": "keyword.operator.chinese.qi",
          "match": "(?<![\\u4e00-\\u9fff\\w])(与|或|等于|不等于|大于等于|小于等于|大于|小于|取余|加|减|乘|除)(?![\\u4e00-\\u9fff\\w])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.qi",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.numeric.float.qi",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.hex.qi",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.qi",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.qi",
          "match": "\\b0[oO][0-7]+\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.qi",
          "match": "[,，]"
        },
        {
          "name": "punctuation.terminator.chinese.qi",
          "match": "；"
        },
        {
          "name": "punctuation.terminator.english.qi",
          "match": ";"
        },
        {
          "name": "punctuation.accessor.qi",
          "match": "[\\.。]"
        },
        {
          "name": "punctuation.bracket.curly.chinese.qi",
          "match": "【】"
        },
        {
          "name": "punctuation.bracket.curly.english.qi",
          "match": "[{}]"
        },
        {
          "name": "punctuation.bracket.square.chinese.qi",
          "match": "［］"
        },
        {
          "name": "punctuation.bracket.square.english.qi",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.bracket.round.chinese.qi",
          "match": "（）"
        },
        {
          "name": "punctuation.bracket.round.english.qi",
          "match": "[()]"
        }
      ]
    }
  }
}