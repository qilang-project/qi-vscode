// Qi 语言示例 - 展示语法高亮功能
// Qi Language Example - Showcasing syntax highlighting features

包 主程序;

// 导入标准库模块
导入 标准库;
导入 标准库.输入输出 { 打印, 读取 };
导入 标准库.集合 as 集合库;

// 枚举声明 - 枚举类型高亮
枚举 状态 {
    就绪,
    运行中,
    完成,
    错误
}

// 结构体声明 - 结构体高亮
结构体 用户 {
    姓名: 字符串,
    年龄: 整数,
    邮箱: 字符串,
    状态: 状态,
    标签: [字符串]
}

// 函数声明 - 函数高亮
函数 创建用户(姓名: 字符串, 年龄: 整数) -> 用户 {
    变量 新用户 = 用户 {
        姓名: 姓名,
        年龄: 年龄,
        邮箱: "",
        状态: 状态::就绪,
        标签: []
    };
    返回 新用户;
}

// 异步函数声明 - 异步函数高亮
异步函数 验证邮箱(邮箱: 字符串) -> 布尔 {
    变量 验证正则 = "^[\\w\\.-]+@[\\w\\.-]+\\.[a-zA-Z]{2,}$";
    // 模拟异步验证
    等待 标准库.时间.等待(1000);
    返回 正则匹配(邮箱, 验证正则);
}

// 主函数演示各种语法特性
函数 入口() -> 整数 {
    打印("Qi 语言 VSCode 扩展示例");

    // 变量声明 - 变量高亮
    变量 用户1 = 创建用户("张三", 25);
    变量 用户2 = 创建用户("李四", 30);

    // 数组和循环 - 数组和循环高亮
    变量 用户列表 = [用户1, 用户2];

    对于 用户 在 用户列表 {
        如果 用户.年龄 >= 18 {
            打印(format!("用户 {} 是成年人", 用户.姓名));

            // 字符串操作和等待表达式
            变量 有效邮箱 = 等待 验证邮箱("user@example.com");
            如果 有效邮箱 {
                打印("邮箱格式正确");
            }
        } 否则 {
            打印(format!("用户 {} 是未成年人", 用户.姓名));
        }
    }

    // 条件语句 - 控制流高亮
    变量 计数器 = 0;
    当 计数器 < 10 {
        计数器 = 计数器 + 1;

        // 嵌套条件判断
        如果 计数器 == 5 {
            打印("计数器达到 5");
            跳出; // 跳出循环
        } 否则 如果 计数器 % 2 == 0 {
            打印(format!("偶数: {}", 计数器));
            继续; // 继续下一次循环
        }
    }

    // 数字类型 - 数字高亮
    变量 整数1 = 42;
    变量 整数2 = 0x2A; // 十六进制
    变量 整数3 = 0b101010; // 二进制
    变量 浮点数1 = 3.14159;
    变量 浮点数2 = 2.5e10; // 科学计数法

    // 布尔值和操作符 - 操作符高亮
    变量 条件1 = 真;
    变量 条件2 = 假;
    变量 结果 = 条件1 && 条件2;
    变量 比较 = 整数1 == 整数2;
    变量 不等 = 整数1 != 整数2;

    // 字符串操作 - 字符串高亮
    变量 消息1 = "你好，世界！";
    变量 消息2 = '单字符';
    变量 组合 = 消息1 + " " + 消息2;

    // 打印最终结果
    打印(format!("程序执行完成，结果: {}", 结果));

    返回 0;
}

// 工具函数
函数 format!(模板: 字符串, ...参数) -> 字符串 {
    // 简化的格式化函数实现
    // 这里应该实现实际的字符串格式化逻辑
    返回 模板;
}

函数 正则匹配(文本: 字符串, 模式: 字符串) -> 布尔 {
    // 简化的正则匹配函数
    // 这里应该实现实际的正则表达式匹配
    返回 假;
}